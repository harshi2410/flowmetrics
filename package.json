{
  "name": "flowmetrics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "next build",
    "build": "npm run build:backend && next build",
    "build:render": "npm install --include=dev && npm --prefix backend install --include=dev && npm run build",
    "start": "node backend/dist/server.js",
    "start:next": "next start",
    "lint": "eslint",
    "db:init": "tsx scripts/init-db.ts",
    "db:seed": "tsx scripts/init-db.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "bcryptjs": "^3.0.3",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}